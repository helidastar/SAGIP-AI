# Copy to .env.local and fill in. Never commit .env.local.
NEXT_PUBLIC_SUPABASE_URL=https://<project>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=
DIRECT_URL=
# gemini | local | mock (mock or empty key = every report goes to human review)
# local = our own ONNX model (training/sagip_classifier_colab.ipynb). Free, no key needed.
#   Its low-confidence answers are escalated to the fallback (e.g. Gemini free tier).
# Team default since 2026-10-25: local primary (88% vs Gemini 79.6% on the 50-photo benchmark),
# Gemini free tier as fallback. Needs the 3 model files in models/ (team Drive).
AI_PROVIDER=local
AI_API_KEY=
# Optional. Defaults: gemini-3.6-flash (gemini), models/sagip-classifier.onnx (local;
# sagip-classifier.onnx.data and labels.json must sit next to the .onnx file)
AI_MODEL=
AI_TIMEOUT_MS=20000
CONFIDENCE_THRESHOLD=0.7
# Fallback provider, used when the primary fails after one retry (gemini),
# or when a local primary is unsure. Gemini free tier keeps this at no cost.
AI_FALLBACK_PROVIDER=gemini
AI_FALLBACK_API_KEY=
# gemini-3.1-flash-lite: the model benchmarked on 2026-10-25, 15 RPM free (the 3.6 default has only 5)
AI_FALLBACK_MODEL=gemini-3.1-flash-lite
# Skip AI providers once today's classification spend (Manila time) reaches this. Empty = no cap.
AI_DAILY_BUDGET_USD=
# Per-IP limit on POST /api/reports (per server instance)
REPORT_RATE_LIMIT=5
REPORT_RATE_WINDOW_MS=600000
