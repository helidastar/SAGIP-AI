# Copy to .env.local and fill in. Never commit .env.local.
NEXT_PUBLIC_SUPABASE_URL=https://<project>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=
DIRECT_URL=
# gemini | claude | mock (mock or empty key = every report goes to human review)
AI_PROVIDER=gemini
AI_API_KEY=
# Optional. Defaults: gemini-2.5-flash (gemini), claude-opus-5 (claude)
AI_MODEL=
AI_TIMEOUT_MS=20000
CONFIDENCE_THRESHOLD=0.7
# Fallback provider, used when the primary fails after one retry (gemini | claude)
AI_FALLBACK_PROVIDER=
AI_FALLBACK_API_KEY=
AI_FALLBACK_MODEL=
# Skip AI providers once today's classification spend (Manila time) reaches this. Empty = no cap.
AI_DAILY_BUDGET_USD=
# Per-IP limit on POST /api/reports (per server instance)
REPORT_RATE_LIMIT=5
REPORT_RATE_WINDOW_MS=600000
