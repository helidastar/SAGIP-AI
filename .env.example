# Copy to .env.local and fill in. Never commit .env.local.
NEXT_PUBLIC_SUPABASE_URL=https://<project>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=
DIRECT_URL=
# gemini | claude | llama | mock (mock or empty key = every report goes to human review)
AI_PROVIDER=gemini
AI_API_KEY=
# Optional. Defaults: gemini-3.6-flash (gemini), claude-opus-5 (claude),
# llama-4-scout-17b-16e-instruct (llama)
AI_MODEL=
# llama only: OpenAI-compatible host. Empty = Groq (https://api.groq.com/openai/v1).
AI_BASE_URL=
AI_TIMEOUT_MS=20000
CONFIDENCE_THRESHOLD=0.7
# Fallback provider, used when the primary fails after one retry (gemini | claude | llama)
AI_FALLBACK_PROVIDER=
AI_FALLBACK_API_KEY=
AI_FALLBACK_MODEL=
AI_FALLBACK_BASE_URL=
# Skip AI providers once today's classification spend (Manila time) reaches this. Empty = no cap.
AI_DAILY_BUDGET_USD=
# Per-IP limit on POST /api/reports (per server instance)
REPORT_RATE_LIMIT=5
REPORT_RATE_WINDOW_MS=600000
