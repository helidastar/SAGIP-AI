# Copy to .env.local and fill in. Never commit .env.local.
NEXT_PUBLIC_SUPABASE_URL=https://<project>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=
DIRECT_URL=
# gemini | claude | mock (mock or empty key = every report goes to human review)
AI_PROVIDER=gemini
AI_API_KEY=
# Optional. Defaults: gemini-2.5-flash (gemini), claude-opus-5 (claude)
AI_MODEL=
AI_TIMEOUT_MS=20000
CONFIDENCE_THRESHOLD=0.7
